# ==============================================================================
# RADAR TECH RECIFE - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================

# Token do seu Bot no Telegram obtido via @BotFather (ex: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# ID do seu Chat, Canal Privado ou Grupo no Telegram (Canais costumam iniciar com -100)
# Para descobrir seu chat_id, envie uma mensagem para o bot e consulte:
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Endereço base da instância RSSHub (Público padrão ou seu container local)
# Padrão público: https://rsshub.app (ou instâncias públicas resilientes)
# Instância Local via Docker: http://localhost:1200
RSSHUB_BASE=https://rsshub.app

# Cookie de sessão do Instagram (OPCIONAL - apenas se usar RSSHub self-hosted para contornar bloqueios do IG)
INSTAGRAM_COOKIE=

# Caminho do banco de dados SQLite local
DB_PATH=data/radar.db

# Intervalo padrão em minutos para execução contínua do agendador (padrão: 30 minutos)
POLL_INTERVAL_MINUTES=30

